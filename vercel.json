{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "tsx script/build-vercel.ts",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@5.1.10",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ]
}
